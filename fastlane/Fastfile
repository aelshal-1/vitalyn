default_platform(:ios)

# Secrets pasted into GitHub sometimes carry spaces, line breaks or quotes.
def clean_env(name)
  ENV.fetch(name).to_s.strip.delete("\"'").gsub(/\s+/, "")
end

platform :ios do
  desc "Build, sign with an App Store distribution certificate and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: clean_env("ASC_KEY_ID"),
      issuer_id: clean_env("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    team_id = clean_env("APPLE_TEAM_ID")
    targets = {
      "Vitalyn" => "com.elshal.vitalyn",
      "VitalynWidgets" => "com.elshal.vitalyn.widgets"
    }

    # Temporary keychain on the CI runner for this run's certificate.
    setup_ci(force: true)

    # The runner starts empty every time, so each run creates a new distribution certificate.
    # Apple caps how many can exist, so revoke the ones earlier runs left behind (approved by
    # the account owner). Builds already on TestFlight are re-signed by Apple and keep working.
    Spaceship::ConnectAPI::Certificate.all.each do |certificate|
      next unless %w[DISTRIBUTION IOS_DISTRIBUTION].include?(certificate.certificate_type)
      UI.message("Revoking old distribution certificate #{certificate.id}")
      certificate.delete!
    end

    get_certificates(
      api_key: api_key,
      development: false,
      generate_apple_certs: true,
      keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
      keychain_password: "",
      output_path: "build/certs"
    )

    profiles = {}
    targets.each do |target, bundle_id|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        team_id: team_id,
        force: true,
        output_path: "build/profiles"
      )
      profiles[bundle_id] = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        path: "Vitalyn.xcodeproj",
        use_automatic_signing: false,
        team_id: team_id,
        targets: [target],
        bundle_identifier: bundle_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profiles[bundle_id]
      )
    end

    build_app(
      project: "Vitalyn.xcodeproj",
      scheme: "Vitalyn",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: profiles
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Check the App Store Connect API key and what the account has (no secrets printed)"
  lane :doctor do
    app_store_connect_api_key(
      key_id: clean_env("ASC_KEY_ID"),
      issuer_id: clean_env("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    begin
      apps = Spaceship::ConnectAPI::App.all
      UI.success("API key works. Apps: #{apps.map(&:bundle_id).join(', ')}")
    rescue => e
      UI.user_error!("API key rejected by Apple: #{e.message}")
    end
    bundle_ids = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
    UI.message("Bundle IDs: #{bundle_ids.join(', ')}")
    certs = Spaceship::ConnectAPI::Certificate.all
    UI.message("Certificates: #{certs.map(&:certificate_type).tally}")
    devices = Spaceship::ConnectAPI::Device.all
    UI.message("Registered devices: #{devices.count}")
    profiles = Spaceship::ConnectAPI::Profile.all
    UI.message("Profiles: #{profiles.map { |p| "#{p.name} (#{p.profile_type})" }.join(', ')}")
  end
end
