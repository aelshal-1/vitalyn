default_platform(:ios)

platform :ios do
  desc "Build, sign (cloud-managed, automatic) and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    ].join(" ")

    build_app(
      project: "Vitalyn.xcodeproj",
      scheme: "Vitalyn",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      },
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}",
      export_xcargs: auth,
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Check the App Store Connect API key and what the account has (no secrets printed)"
  lane :doctor do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    begin
      apps = Spaceship::ConnectAPI::App.all
      UI.success("API key works. Apps: #{apps.map(&:bundle_id).join(', ')}")
    rescue => e
      UI.user_error!("API key rejected by Apple: #{e.message}")
    end
    bundle_ids = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
    UI.message("Bundle IDs: #{bundle_ids.join(', ')}")
    certs = Spaceship::ConnectAPI::Certificate.all
    UI.message("Certificates: #{certs.map(&:certificate_type).tally}")
    devices = Spaceship::ConnectAPI::Device.all
    UI.message("Registered devices: #{devices.count}")
    profiles = Spaceship::ConnectAPI::Profile.all
    UI.message("Profiles: #{profiles.map { |p| "#{p.name} (#{p.profile_type})" }.join(', ')}")
  end
end
